<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Inmuebles arrendados para el modelo 180: datos del inmueble que pide el registro de perceptor (situación,
 * referencia catastral y dirección), ligados al proveedor (arrendador).
 *
 * @author Daniel Fernández Giménez <contacto@danielfg.es>
-->
<table>
    <column>
        <name>bloque</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>calificador</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>codmunicipio</name>
        <type>character varying(5)</type>
    </column>
    <column>
        <name>codpostal</name>
        <type>character varying(5)</type>
    </column>
    <column>
        <name>codproveedor</name>
        <type>character varying(10)</type>
        <null>NO</null>
    </column>
    <column>
        <name>codprovincia</name>
        <type>character varying(2)</type>
    </column>
    <column>
        <name>complemento</name>
        <type>character varying(40)</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>descripcion</name>
        <type>character varying(100)</type>
    </column>
    <column>
        <name>escalera</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>last_update</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>localidad</name>
        <type>character varying(30)</type>
    </column>
    <column>
        <name>municipio</name>
        <type>character varying(30)</type>
    </column>
    <column>
        <name>nombrevia</name>
        <type>character varying(50)</type>
    </column>
    <column>
        <name>numero</name>
        <type>character varying(5)</type>
    </column>
    <column>
        <name>planta</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>porcentaje</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>portal</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>puerta</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>refcatastral</name>
        <type>character varying(20)</type>
    </column>
    <column>
        <name>situacion</name>
        <type>integer</type>
        <default>1</default>
    </column>
    <column>
        <name>tiponumeracion</name>
        <type>character varying(3)</type>
    </column>
    <column>
        <name>tipovia</name>
        <type>character varying(5)</type>
    </column>
    <constraint>
        <name>modelo180_inmuebles_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>ca_modelo180_inmuebles_proveedores</name>
        <type>FOREIGN KEY (codproveedor) REFERENCES proveedores (codproveedor) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>
